# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- ESPN private league auth ---
# Log into fantasy.espn.com in your browser, open DevTools > Application/Storage > Cookies,
# and copy the values of the "espn_s2" and "SWID" cookies (SWID includes the surrounding braces).
ESPN_S2=
SWID={xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
ESPN_LEAGUE_ID=
ESPN_YEAR=2026

# --- Supabase ---
# Use the service role key here (Project Settings > API), not the anon key — this script
# runs locally, not in the browser, and the service key bypasses RLS for a reliable upsert.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
