# Copy this file to .env.local and fill in real values. .env.local is gitignored — never commit it.
# Get these from your Supabase project: Settings > API.
# Use the anon/public key here (not the service role key) — this is exposed to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
